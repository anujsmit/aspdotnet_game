<Window x:Class="BoomAvoider.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boom Avoider"
        Width="750"
        Height="900"
        MinWidth="640"
        MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ================= COLORS ================= -->

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#6C5CE7"/>

        <SolidColorBrush x:Key="DarkBrush"
                         Color="#171A2B"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#202438"/>

        <SolidColorBrush x:Key="MutedBrush"
                         Color="#7C829B"/>


        <!-- ================= BASE TILE ================= -->

        <Style x:Key="BaseTileStyle"
               TargetType="Button">

            <Setter Property="FontSize"
                    Value="36"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="6"/>

            <Setter Property="MinHeight"
                    Value="90"/>

            <Setter Property="MinWidth"
                    Value="90"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="TileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="TileBorder"
                                        Property="Background"
                                        Value="#F0EEFF"/>

                                <Setter TargetName="TileBorder"
                                        Property="BorderBrush"
                                        Value="#B7AEFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="TileBorder"
                                        Property="Background"
                                        Value="#E4E0FF"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="TileBorder"
                                        Property="Opacity"
                                        Value="1"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================= GAME TILE ================= -->

        <Style x:Key="GameTileStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseTileStyle}">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7F0"/>

            <Setter Property="Foreground"
                    Value="#30354D"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Effect">

                <Setter.Value>

                    <DropShadowEffect
                        Color="#B9BFD0"
                        BlurRadius="6"
                        ShadowDepth="1"
                        Opacity="0.35"/>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================= SAFE TILE ================= -->

        <Style x:Key="SafeTileStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseTileStyle}">

            <Setter Property="Background"
                    Value="#E8FFF3"/>

            <Setter Property="BorderBrush"
                    Value="#A9EBCB"/>

            <Setter Property="Foreground"
                    Value="#0DAD68"/>

            <Setter Property="FontSize"
                    Value="40"/>

            <Setter Property="Cursor"
                    Value="Arrow"/>

            <Setter Property="IsEnabled"
                    Value="False"/>

        </Style>


        <!-- ================= BOMB TILE ================= -->

        <Style x:Key="BombTileStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseTileStyle}">

            <Setter Property="Background"
                    Value="#FFE8EC"/>

            <Setter Property="BorderBrush"
                    Value="#FFB6C2"/>

            <Setter Property="Foreground"
                    Value="#E5395B"/>

            <Setter Property="FontSize"
                    Value="40"/>

            <Setter Property="Cursor"
                    Value="Arrow"/>

            <Setter Property="IsEnabled"
                    Value="False"/>

        </Style>


        <!-- ================= NEW GAME BUTTON ================= -->

        <Style x:Key="NewGameStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="35,16"/>

            <Setter Property="MinWidth"
                    Value="210"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="NewGameBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">

                            <Border.Effect>

                                <DropShadowEffect
                                    Color="#6C5CE7"
                                    BlurRadius="12"
                                    ShadowDepth="3"
                                    Opacity="0.25"/>

                            </Border.Effect>

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="NewGameBorder"
                                        Property="Background"
                                        Value="#5848D2"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="NewGameBorder"
                                        Property="Background"
                                        Value="#4435B5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ================= MAIN WINDOW ================= -->

    <Grid>

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Padding="0,0,4,0">

            <StackPanel
                MaxWidth="570"
                HorizontalAlignment="Center"
                Margin="30,25,30,30">


                <!-- ================= HEADER ================= -->

                <StackPanel
                    HorizontalAlignment="Center"
                    Margin="0,0,0,28">

                    <Border
                        Background="#E8E5FF"
                        CornerRadius="20"
                        Padding="14"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,14">

                        <TextBlock
                            Text="💣"
                            FontSize="34"
                            FontFamily="Segoe UI Emoji"
                            HorizontalAlignment="Center"/>

                    </Border>

                    <TextBlock
                        Text="Boom Avoider"
                        FontSize="38"
                        FontWeight="ExtraBold"
                        Foreground="{StaticResource DarkBrush}"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Text="Find the safe tiles. Avoid the bomb."
                        FontSize="16"
                        FontWeight="Medium"
                        Foreground="{StaticResource MutedBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"/>

                </StackPanel>


                <!-- ================= STATS ================= -->

                <Grid Margin="0,0,0,25">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>


                    <!-- SCORE -->

                    <Border
                        Grid.Column="0"
                        Background="#FFFFFF"
                        CornerRadius="16"
                        Margin="4"
                        Padding="12,14"
                        BorderBrush="#E7E9F1"
                        BorderThickness="1">

                        <StackPanel>

                            <TextBlock
                                Text="SCORE"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#8B91A8"
                                HorizontalAlignment="Center"/>

                            <TextBlock
                                x:Name="ScoreText"
                                Text="0"
                                FontSize="28"
                                FontWeight="ExtraBold"
                                Foreground="#6C5CE7"
                                HorizontalAlignment="Center"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- BOMBS -->

                    <Border
                        Grid.Column="1"
                        Background="#FFFFFF"
                        CornerRadius="16"
                        Margin="4"
                        Padding="12,14"
                        BorderBrush="#E7E9F1"
                        BorderThickness="1">

                        <StackPanel>

                            <TextBlock
                                Text="BOMBS"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#8B91A8"
                                HorizontalAlignment="Center"/>

                            <TextBlock
                                x:Name="BombText"
                                Text="1"
                                FontSize="28"
                                FontWeight="ExtraBold"
                                Foreground="#E5395B"
                                HorizontalAlignment="Center"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- SAFE LEFT -->

                    <Border
                        Grid.Column="2"
                        Background="#FFFFFF"
                        CornerRadius="16"
                        Margin="4"
                        Padding="12,14"
                        BorderBrush="#E7E9F1"
                        BorderThickness="1">

                        <StackPanel>

                            <TextBlock
                                Text="SAFE LEFT"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#8B91A8"
                                HorizontalAlignment="Center"/>

                            <TextBlock
                                x:Name="SafeTilesText"
                                Text="8"
                                FontSize="28"
                                FontWeight="ExtraBold"
                                Foreground="#0DAD68"
                                HorizontalAlignment="Center"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================= GAME BOARD ================= -->

                <Border
                    Background="#FFFFFF"
                    CornerRadius="22"
                    Padding="22"
                    BorderBrush="#E7E9F1"
                    BorderThickness="1">

                    <StackPanel>

                        <TextBlock
                            Text="CHOOSE A TILE"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#596078"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,5"/>

                        <TextBlock
                            Text="Find all 8 safe tiles to win!"
                            FontSize="13"
                            Foreground="#9AA0B5"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18"/>

                        <UniformGrid
                            x:Name="GameBoard"
                            Rows="3"
                            Columns="3"
                            HorizontalAlignment="Center"
                            Width="400"
                            Height="400"/>

                    </StackPanel>

                </Border>


                <!-- ================= NEW GAME ================= -->

                <Button
                    Content="🔄   NEW GAME"
                    Style="{StaticResource NewGameStyle}"
                    Click="NewGame_Click"
                    HorizontalAlignment="Center"
                    Padding="35,20"
                    Margin="0,28,0,25"/>


                <!-- ================= FOOTER ================= -->

                <TextBlock
                    Text="Boom Avoider  •  Have fun!"
                    FontSize="13"
                    FontWeight="Medium"
                    Foreground="#A4A9BB"
                    HorizontalAlignment="Center"
                    Margin="0,22,0,0"/>

            </StackPanel>

        </ScrollViewer>


        <!-- ================= RESULT OVERLAY ================= -->

        <Grid
            x:Name="ResultOverlay"
            Background="#B3000000"
            Visibility="Collapsed"
            Panel.ZIndex="10">

            <Border
                Background="White"
                CornerRadius="24"
                Padding="40,36"
                MaxWidth="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Border.Effect>

                    <DropShadowEffect
                        Color="#000000"
                        BlurRadius="30"
                        ShadowDepth="6"
                        Opacity="0.35"/>

                </Border.Effect>


                <StackPanel>


                    <!-- RESULT ICON -->

                    <Border
                        x:Name="ResultIconBg"
                        Background="#E8FFF3"
                        CornerRadius="24"
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,18">

                        <TextBlock
                            x:Name="ResultIcon"
                            Text="✓"
                            FontSize="40"
                            FontWeight="Bold"
                            Foreground="#0DAD68"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>


                    <!-- RESULT TITLE -->

                    <TextBlock
                        x:Name="ResultTitle"
                        Text="You Win!"
                        FontSize="28"
                        FontWeight="ExtraBold"
                        Foreground="#171A2B"
                        HorizontalAlignment="Center"/>


                    <!-- RESULT SUBTITLE -->

                    <TextBlock
                        x:Name="ResultSubtitle"
                        Text="You found every safe tile."
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="#7C829B"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,24"/>


                    <!-- SCORE ROW -->

                    <Border
                        Background="#F4F7FB"
                        CornerRadius="14"
                        Padding="18,14"
                        Margin="0,0,0,24">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>


                            <!-- SCORE -->

                            <StackPanel Grid.Column="0">

                                <TextBlock
                                    Text="SCORE"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="#8B91A8"
                                    HorizontalAlignment="Center"/>

                                <TextBlock
                                    x:Name="ResultScore"
                                    Text="0"
                                    FontSize="24"
                                    FontWeight="ExtraBold"
                                    Foreground="#6C5CE7"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,0"/>

                            </StackPanel>


                            <!-- BEST -->

                            <StackPanel Grid.Column="1">

                                <TextBlock
                                    Text="BEST"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="#8B91A8"
                                    HorizontalAlignment="Center"/>

                                <TextBlock
                                    x:Name="ResultBest"
                                    Text="0"
                                    FontSize="24"
                                    FontWeight="ExtraBold"
                                    Foreground="#0DAD68"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- PLAY AGAIN -->

                    <Button
                        x:Name="PlayAgainButton"
                        Content="🔄   PLAY AGAIN"
                        Style="{StaticResource NewGameStyle}"
                        Click="NewGame_Click"
                        Padding="35,18"
                        HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>